---
// Previous / next links at the foot of a ported article, styled like the Learn guides' "Continue
// learning" pair. Replaces the old site's React post and guide navigation bars.
export interface PagerLink { href: string; kicker: string; title: string }
interface Props { label: string; previous?: PagerLink; next?: PagerLink }
const { label, previous, next } = Astro.props;
---
{(previous || next) && <nav class="pager" aria-label={label}>
 {previous ? <a href={previous.href}><span>{previous.kicker}</span><strong>← {previous.title}</strong></a> : <span class="pager-gap" />}
 {next && <a class="next" href={next.href}><span>{next.kicker}</span><strong>{next.title} →</strong></a>}
</nav>}
<style>
 .pager{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:64px}
 .pager a{display:flex;flex-direction:column;gap:12px;border:1px solid var(--web-outline);padding:24px;text-decoration:none;color:var(--foreground);transition:background-color 180ms ease-out}
 .pager a:hover{background:var(--web-tile)}
 .pager a:focus-visible{outline:2px solid var(--ring);outline-offset:2px}
 .pager a.next{border-color:var(--primary);text-align:right}
 .pager span{font-size:14px;line-height:20px;color:var(--muted-foreground)}
 .pager strong{font:600 18px/26px var(--font-heading);text-wrap:balance}
 @media(max-width:600px){.pager{grid-template-columns:1fr}.pager-gap{display:none}.pager a.next{text-align:left}}
 @media(prefers-reduced-motion:reduce){.pager a{transition:none}}
</style>
