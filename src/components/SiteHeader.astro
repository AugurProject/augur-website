---
import "@/components/ui/button.css";
import { buttonVariants } from "@/components/ui/button-variants";
import { primaryNavigation, resourceNavigation, siteRoutes } from "@/lib/site";

// Pinned identity source: jubalm/augur-design-system@a95bf329be66697c5dbd87a484a390139046aaf9
// resources/brand/assets/horizontal/{color,reversed}.png; hashes in resources/brand/PROVENANCE.md.

const pathname = Astro.url.pathname.replace(/\/?$/, "/");
const isCurrent = (href: string) => pathname === href;
const inResources = resourceNavigation.some(({ href }) => isCurrent(href));
const describe = (href: string) => siteRoutes.find((route) => route.href === href)?.boundary;
---

<header class="site-header augur-type-ui">
  <div class="site-frame site-header__inner">
    <a class="site-header__brand" href="/" aria-label="Augur home" aria-current={isCurrent("/") ? "page" : undefined}>
      <img class="site-brand-light" src="/brand/augur-horizontal-color.png" width="1440" height="481" alt="" />
      <img class="site-brand-dark" src="/brand/augur-horizontal-reversed.png" width="1440" height="481" alt="" />
    </a>

    <nav class="site-header__desktop-nav" aria-label="Main navigation">
      {primaryNavigation.slice(0, 2).map(({ href, label }) => (
        <a class="site-nav-link" href={href} aria-current={isCurrent(href) ? "page" : undefined}>{label}</a>
      ))}
      <details class="site-nav-resources" data-current-section={inResources ? "" : undefined}>
        <summary class="site-nav-link">
          Resources
          <svg class="site-icon site-icon--chevron" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><polyline points="6 9 12 15 18 9" /></svg>
        </summary>
        <div class="site-nav-resources__panel">
          {resourceNavigation.map(({ href, label }) => (
            <a href={href} aria-current={isCurrent(href) ? "page" : undefined}>
              <span class="site-nav-resources__label">{label}</span>
              <span class="site-nav-resources__desc augur-type-metadata">{describe(href)}</span>
            </a>
          ))}
        </div>
      </details>
      {primaryNavigation.slice(2).map(({ href, label }) => (
        <a class="site-nav-link" href={href} aria-current={isCurrent(href) ? "page" : undefined}>{label}</a>
      ))}
    </nav>

    <div class="site-header__desktop-actions">
      <button type="button" class="site-theme-toggle" data-site-theme-toggle aria-label="Switch color theme">
        <svg class="site-icon site-icon--sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="5" fill="currentColor" /><line x1="12" y1="1" x2="12" y2="3" /><line x1="12" y1="21" x2="12" y2="23" /><line x1="4.22" y1="4.22" x2="5.64" y2="5.64" /><line x1="18.36" y1="18.36" x2="19.78" y2="19.78" /><line x1="1" y1="12" x2="3" y2="12" /><line x1="21" y1="12" x2="23" y2="12" /><line x1="4.22" y1="19.78" x2="5.64" y2="18.36" /><line x1="18.36" y1="5.64" x2="19.78" y2="4.22" /></svg>
        <svg class="site-icon site-icon--moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" fill="currentColor" /></svg>
      </button>
      <a class={`${buttonVariants({ size: "lg" })} site-header__action`} href="/protocol/">How Augur works</a>
    </div>

    <details class="site-mobile-menu">
      <summary class="augur-type-control">
        <span class="site-mobile-menu__when-closed">Menu</span>
        <span class="site-mobile-menu__when-open">Close</span>
        <svg class="site-icon site-mobile-menu__when-closed" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><line x1="3" y1="8" x2="21" y2="8" /><line x1="3" y1="16" x2="21" y2="16" /></svg>
        <svg class="site-icon site-mobile-menu__when-open" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
      </summary>
      <div class="site-mobile-menu__panel">
        <nav aria-label="Mobile navigation">
          <ul class="site-mobile-menu__list">
            {primaryNavigation.map(({ href, label }) => (
              <li><a href={href} aria-current={isCurrent(href) ? "page" : undefined}>{label}</a></li>
            ))}
          </ul>
          <p class="site-mobile-menu__group augur-type-editorial-label">Resources</p>
          <ul class="site-mobile-menu__list">
            {resourceNavigation.map(({ href, label }) => (
              <li><a href={href} aria-current={isCurrent(href) ? "page" : undefined}>{label}</a></li>
            ))}
          </ul>
        </nav>
        <a class={`${buttonVariants({ size: "lg" })} site-mobile-menu__action`} href="/protocol/">How Augur works</a>
        <div class="site-mobile-menu__theme">
          <span>Theme</span>
          <button type="button" class="site-theme-toggle site-theme-toggle--labelled" data-site-theme-toggle aria-label="Switch color theme">
            <svg class="site-icon site-icon--sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="5" fill="currentColor" /><line x1="12" y1="1" x2="12" y2="3" /><line x1="12" y1="21" x2="12" y2="23" /><line x1="4.22" y1="4.22" x2="5.64" y2="5.64" /><line x1="18.36" y1="18.36" x2="19.78" y2="19.78" /><line x1="1" y1="12" x2="3" y2="12" /><line x1="21" y1="12" x2="23" y2="12" /><line x1="4.22" y1="19.78" x2="5.64" y2="18.36" /><line x1="18.36" y1="5.64" x2="19.78" y2="4.22" /></svg>
            <svg class="site-icon site-icon--moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" fill="currentColor" /></svg>
            <span class="site-theme-toggle__name" data-site-theme-name>Light</span>
          </button>
        </div>
      </div>
    </details>
  </div>
</header>
