---
import IsoNodes from '@/lib/iso/IsoNodes.astro';
import { aboutScene } from './about-scene';
// The About hero's stack (about-scene.ts), drawn at rest, so no JavaScript, reduced motion and print show the
// finished stack. The script plays its track; the lift rises above the box, so the svg lets it show.
const { world, motion, width, height, transform } = aboutScene;
---
<svg class="about-scene" viewBox={`0 0 ${width} ${height}`} width={width} height={height} data-about-scene={JSON.stringify(motion)} aria-hidden="true">
  <g transform={transform}><IsoNodes nodes={world}/></g>
</svg>
<script>import './about-scene-loop';</script>
<style>
  .about-scene { display:block; max-width:100%; height:auto; overflow:visible }
  @media(max-width:767px) { .about-scene { width:180px } }
</style>
