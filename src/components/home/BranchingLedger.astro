---
// Section 06 figure, conceptual. One universe line splits at a fork into
// Invalid, Yes and No child universes, each with its own REP. Every branch is
// drawn identically: Zoltar never selects or deletes one (Zoltar docs,
// "Zoltar and branching universes"). Lines are drawn in SVG; every label is
// real text.
const children = ["Invalid", "Yes", "No"];
---

<figure class="ledger" aria-labelledby="ledger-caption" data-motion="ledger">
  <p class="ledger__tag augur-type-editorial-label">Conceptual</p>
  <div class="ledger__diagram">
    <svg class="ledger__lines ledger__lines--wide" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <line class="ledger__connector" x1="10" y1="13" x2="10" y2="50" />
      <line class="ledger__connector" x1="28" y1="13" x2="28" y2="50" />
      <line class="ledger__connector ledger__connector--yours" x1="46" y1="13" x2="46" y2="50" />
      <line class="ledger__parent-line" x1="0" y1="50" x2="58" y2="50" />
    </svg>
    <svg class="ledger__lines ledger__lines--wide ledger__branches" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <path d="M58 50 C 70 50, 72 14, 84 14" />
      <path d="M58 50 L 84 50" />
      <path d="M58 50 C 70 50, 72 86, 84 86" />
    </svg>

    <svg class="ledger__lines ledger__lines--tall" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <line class="ledger__connector" x1="16.6667" y1="11" x2="16.6667" y2="26" />
      <line class="ledger__connector" x1="50" y1="11" x2="50" y2="26" />
      <line class="ledger__connector ledger__connector--yours" x1="83.3333" y1="11" x2="83.3333" y2="26" />
      <line class="ledger__parent-line" x1="4" y1="26" x2="96" y2="26" />
      <line class="ledger__parent-line" x1="50" y1="26" x2="50" y2="52" />
    </svg>
    <svg class="ledger__lines ledger__lines--tall ledger__branches" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <path d="M50 52 C 50 64, 16.6667 66, 16.6667 80" />
      <path d="M50 52 L 50 80" />
      <path d="M50 52 C 50 64, 83.3333 66, 83.3333 80" />
    </svg>

    <ul class="ledger__designs" aria-label="Oracle designs that share REP">
      <li>Design A</li>
      <li>Design B</li>
      <li data-yours="">Your design</li>
    </ul>

    <p class="ledger__parent">
      <strong>Parent universe</strong>
      <span>Questions, markets and REP</span>
    </p>

    <p class="ledger__fork">
      <span class="ledger__fork-node" aria-hidden="true"></span>
      <span class="ledger__fork-text">
        <strong>Fork</strong>
        <span>When disagreement persists</span>
      </span>
    </p>

    <ul class="ledger__children" aria-label="Child universes after a fork">
      {children.map((child) => (
        <li>
          <span class="ledger__child-node" aria-hidden="true"></span>
          <strong>{child}</strong>
          <span>Own REP</span>
        </li>
      ))}
    </ul>
  </div>
  <figcaption id="ledger-caption" class="ledger__caption">
    Each child universe keeps its own REP. Zoltar never selects or deletes a branch: applications and users decide
    where activity continues.
  </figcaption>
</figure>
