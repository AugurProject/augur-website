---
/** One picture per use case of what its app does with the answer (owner, 19 Oct 2026, after SEDA's
 * use-case cards; "figure out a better place and size"). It sits under the action at the full width of
 * the stage's right column and takes the rest of its height, so it reads as the app's view of the answer.
 * The three share one scale (2 px tracks, 16 px marks), so no case looks smaller than the market chart.
 * Labels only name what the explanation above does not (owner, 19 Oct 2026: clear and organized).
 * Rendered final, so no JavaScript, reduced motion and print show the end state; case-graphics.ts
 * plays it in. Decorative: the sentence says it. Green marks only where the answer acts.
 * Polish pass (owner, 19 Oct 2026: the plays were "awful, simple and weird"): each picture now tells its
 * own before, answer and after, and one Green ring marks the instant the answer acts. */
interface Props { kind: 'market' | 'flight' | 'gate' }
const { kind } = Astro.props;
// Market: the Yes price in a 600 × 120 space, where a price of 1 sits at y 8 and 0 at y 112, on the
// grid's three lines. It trades near even until the rocket reaches orbit at x 300. The market knows at
// once (owner, 19 Oct 2026), so Yes jumps and climbs to 99%, where it waits for the answer at x 432;
// the answer settles it at 1 by x 444 and it holds there. No is its mirror, since the two prices of a
// Yes-or-No market add up to 1.
const price = (p: number) => +(8 + (1 - p) * 104).toFixed(1);
const knownX = 300, answerX = 432, settledX = 444;
const chance = (x: number) => x <= knownX
  ? .48 + .17 * (x / knownX) + .045 * Math.sin(x / 26) + .022 * Math.sin(x / 9.5 + 1) + .01 * Math.sin(x / 4.1 + 2)
  : .99 - .09 * Math.exp(-(x - knownX - 12) / 20);
const trading = Array.from({ length: answerX / 12 + 1 }, (_, i) => [i * 12, price(chance(i * 12))]);
const yes = [...trading, [settledX, price(1)], [600, price(1)]];
const no = yes.map(([x, y]) => [x, 120 - y]);
const points = (rows: number[][]) => rows.map(([x, y]) => `${x},${y}`).join(' ');
const area = `M${points(yes).replaceAll(' ', 'L')}L600,120L0,120Z`;
// Flight: the arrival passes the +2 hours limit at 62% of the track and lands at 84%. The cabin is 24 rows
// of four seats across an aisle, seen from above. Only some seats hold a policy (a fixed pattern, so every
// render matches); those fill Green column by column once the flight passes the limit.
const limit = 62, arrival = 84;
const rows = Array.from({ length: 24 }, (_, row) => row);
const insured = (row: number, seat: number) => (row * 5 + seat * 3) % 7 < 3;
// The gate's check, the design system's check path (icons/check.svg) as a polyline so it can draw in.
const check = '4.5 10.5 8.25 14.25 15.5 7';
---
<div class:list={['case-graphic', `is-${kind}`]} aria-hidden="true" data-case-graphic={kind}>
 {kind === 'market' && <div class="market">
  <div class="market-plot" style={`--answer:${answerX / 6}%;--settled:${settledX / 6}%`}>
   <span class="market-grid"><i data-market-grid></i><i data-market-grid></i><i data-market-grid></i></span>
   <span class="market-answer" data-market-answer></span>
   <span class="market-window" data-market-window>
    <span class="market-art" data-market-art><svg viewBox="0 0 600 120" preserveAspectRatio="none" focusable="false">
     <defs><linearGradient id="market-area" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="currentColor" stop-opacity=".14"/><stop offset=".75" stop-color="currentColor" stop-opacity="0"/></linearGradient></defs>
     <path class="market-area" d={area} fill="url(#market-area)"/>
     <polyline class="market-line is-no" points={points(no)} />
     <polyline class="market-line is-yes" points={points(yes)} data-market-yes />
    </svg></span>
    <span class="market-head is-yes" data-market-head="yes" style={`transform:translateY(${price(1) / 1.2}%)`}><i></i></span>
    <span class="market-head is-no" data-market-head="no" style={`transform:translateY(${(120 - price(1)) / 1.2}%)`}><i></i></span>
   </span>
   <span class="g-pulse market-pulse" data-graphic-pulse></span>
   <span class="market-scrub" data-market-scrub><span class="scrub-line"></span><i class="scrub-dot is-no"></i><i class="scrub-dot is-yes"></i></span>
  </div>
  <div class="market-ends">
   <span class="g-end is-strong is-top" data-graphic-end>Yes</span>
   <span class="g-end is-bottom" data-graphic-end>No</span>
  </div>
 </div>}
 {kind === 'flight' && <div class="flight" style={`--limit:${limit}%;--arrival:${arrival}%;--limit-run:${(limit / arrival * 100).toFixed(3)}%`} data-limit={limit / arrival}>
  <div class="g-track">
   <span class="g-base"></span>
   <span class="flight-window" data-flight-window><span class="flight-progress" data-flight-progress><i></i><i class="is-late"></i></span></span>
   <span class="g-tick"></span><span class="g-tick is-limit"></span>
   <span class="g-pulse flight-pulse" data-graphic-pulse></span>
   <span class="flight-run" data-flight-run><span class="g-item"></span></span>
  </div>
  <div class="g-labels"><span>Due</span><span class="at-limit">+2 hours</span><span class="at-arrival" data-flight-landed>Landed</span></div>
  <div class="cabin">{[0, 2].map(side => <div class="cabin-side">{rows.map(row => [0, 1].map(seat => <span class:list={['g-seat', { 'is-insured': insured(row, side + seat) }]}>{insured(row, side + seat) && <span data-seat-paid={row} data-seat-across={side + seat}></span>}</span>))}</div>)}</div>
  <div class="g-row"><span class="g-end is-strong"><i></i>Paid</span><span class="g-end"><i class="is-raised"></i>No policy</span></div>
 </div>}
 {kind === 'gate' && <div class="gate">
  <div class="gate-lane">
   <span class="gate-caption">This review</span>
   <div class="g-track">
    <span class="gate-path"></span><span class="gate-ahead"></span>
    <span class="gate-bars"><i data-gate-bar></i><i data-gate-bar></i></span><span class="gate-goal"></span>
    <span class="gate-run" data-gate-run><span class="g-item" data-gate-item></span></span>
   </div>
  </div>
  <div class="gate-lane is-later" data-gate-later-lane>
   <span class="gate-caption">A later review</span>
   <div class="g-track">
    <span class="gate-path"></span>
    <span class="gate-check"><svg viewBox="0 0 20 20" focusable="false"><polyline points={check} pathLength="1" data-gate-check /></svg></span>
    <span class="gate-run" data-gate-later><span class="g-item"></span></span>
    <span class="g-pulse gate-pulse" data-graphic-pulse></span>
   </div>
  </div>
  <div class="g-labels"><span>Proposal</span><span class="at-gate">Review</span><span class="at-end">Live</span></div>
 </div>}
</div>
<style>
 /* The picture follows the explanation; the market chart grows to fill the rest of the example, and the
    flight and gate pictures keep their size, leaving any spare room at the example's foot. */
 .case-graphic{--gate:62%;flex:1;display:flex;flex-direction:column;width:100%;padding-top:32px;color:var(--muted-foreground);font:400 13px/16px var(--font-body)}
 .g-end{display:inline-flex;align-items:center;gap:8px;white-space:nowrap}
 .g-end.is-strong{color:var(--foreground);font:600 13px/16px var(--font-heading)}
 .g-end i{width:8px;height:8px;flex:none;background:var(--primary)}.g-end i.is-raised{background:var(--web-raised)}
 /* One ring marks the instant the answer acts. It rests invisible and only shows while it plays. */
 .g-pulse{position:absolute;width:32px;height:32px;margin:-16px 0 0 -16px;border:1px solid var(--primary);opacity:0;pointer-events:none}
 /* Market: a price chart. Three grid lines (1, ½, 0) hold two prices that stretch with the column (strokes
    stay 2 px). A window slides open while the art inside slides back the same amount, so the prices draw
    left to right with only transform moving, and each price's head rides the window's edge. */
 .market{flex:1;display:grid;grid-template-columns:minmax(0,1fr) auto;column-gap:12px;min-height:120px}
 .market-plot{position:relative;min-height:120px}
 .market-grid i{position:absolute;left:0;right:0;top:calc(8 / 120 * 100%);height:1px;background:var(--web-outline);transform-origin:left}
 .market-grid i:nth-child(2){top:50%}.market-grid i:nth-child(3){top:calc(112 / 120 * 100%)}
 .market-answer{position:absolute;left:var(--answer);top:0;bottom:0;border-left:1px dashed var(--augur-color-surface-dark-mist);transform-origin:bottom}
 .market-window,.market-art{position:absolute;inset:0}.market-window{overflow:hidden}
 .market-plot svg{position:absolute;inset:0;width:100%;height:100%;color:var(--primary)}
 .market-line{fill:none;stroke-width:2;stroke-linejoin:round;vector-effect:non-scaling-stroke}
 .market-line.is-yes{stroke:var(--primary)}.market-line.is-no{stroke:var(--augur-color-surface-dark-mist)}
 .market-head{position:absolute;inset:0;pointer-events:none}
 .market-head i{position:absolute;right:0;top:-4px;width:8px;height:8px;background:var(--primary)}.market-head.is-no i{background:var(--augur-color-surface-dark-mist)}
 .market-pulse{left:var(--settled);top:calc(8 / 120 * 100%)}
 /* Hover, fine pointers only (owner, 19 Oct 2026: "a little interactive when hovering"): a crosshair
    reads the two prices under the pointer, as a trading chart does, as chances out of 100; past the
    answer it reads "Settled: Yes". It rests hidden, moves on transform only (case-graphics.ts), and its
    readout sits in the space above the plot, flipping left near the right edge. */
 .market-scrub{position:absolute;inset:0;opacity:0;transition:opacity 160ms ease-out;pointer-events:none}
 .market-scrub.is-on{opacity:1}
 .scrub-line{position:absolute;left:0;top:0;bottom:0;width:1px;margin-left:-.5px;background:var(--augur-color-surface-dark-mist)}
 .scrub-dot{position:absolute;left:-4px;top:-4px;width:8px;height:8px;background:var(--augur-color-surface-dark-mist)}
 .scrub-dot.is-yes{background:var(--primary)}
 .market-scrub :global(.scrub-read){position:absolute;left:0;top:-30px;display:flex;padding:4px 8px;background:var(--background);box-shadow:inset 0 0 0 1px var(--web-outline);font:400 12px/16px var(--font-body);color:var(--muted-foreground);white-space:nowrap}
 .market-scrub :global(.scrub-read b){font:600 12px/16px var(--font-heading);font-variant-numeric:tabular-nums;color:var(--foreground)}
 .market-scrub :global(.scrub-prices){display:flex;gap:12px}.market-scrub :global(.scrub-prices .is-yes b){color:var(--primary)}
 .market-scrub :global(.scrub-settled),.market-scrub :global(.scrub-read.is-settled .scrub-prices){display:none}.market-scrub :global(.scrub-read.is-settled .scrub-settled){display:inline}
 @media(hover:hover) and (pointer:fine){.market-plot{cursor:crosshair}}
 @media(prefers-reduced-motion:reduce){.market-scrub{transition:none}}
 .market-ends{position:relative;min-width:24px}
 .market-ends .g-end{position:absolute;left:0;margin-top:-8px}.market-ends .is-top{top:calc(8 / 120 * 100%)}.market-ends .is-bottom{top:calc(112 / 120 * 100%)}
 /* Flight and gate: a track with labelled ticks; the moving square rides the end of a run that slides
    its own width, so it lands exactly where the final layout puts it. */
 .g-track{position:relative;height:32px}
 .g-base{position:absolute;left:0;right:0;top:15px;height:2px;background:var(--web-outline)}
 .g-tick{position:absolute;left:0;top:4px;width:2px;height:24px;background:var(--muted-foreground)}.g-tick.is-limit{left:var(--limit);margin-left:-1px;background:var(--foreground)}
 .g-item{position:absolute;right:-8px;top:8px;width:16px;height:16px;background:var(--foreground)}
 /* The delay is Paper up to the limit and Green past it, where the policies pay. It draws with the
    arrival, through a window that slides open as the art inside slides back. */
 .flight-window{position:absolute;left:0;top:15px;width:var(--arrival);height:2px;overflow:hidden}
 .flight-progress{position:absolute;inset:0}
 .flight-progress i{position:absolute;top:0;bottom:0;left:0;width:var(--limit-run);background:var(--foreground)}
 .flight-progress i.is-late{left:var(--limit-run);right:0;width:auto;background:var(--primary)}
 .flight-pulse{left:var(--limit);top:16px}
 .flight-run{position:absolute;inset:0 auto 0 0;width:var(--arrival)}
 .g-labels{position:relative;height:16px;margin-top:10px}
 .g-labels>span{position:absolute;white-space:nowrap}
 .g-labels .at-limit{left:var(--limit);transform:translateX(-50%)}.g-labels .at-arrival{left:var(--arrival);color:var(--foreground);transform:translateX(-50%)}.g-labels .at-gate{left:var(--gate);transform:translateX(-50%)}.g-labels .at-end{right:0}
 .g-row{display:flex;flex-wrap:wrap;align-items:center;gap:8px 24px;margin-top:20px}
 /* The cabin spans the track's width: two sides of two seats, an aisle between them; seats stay square
    and shrink with the column. A seat with a policy is outlined until its payout fills it. Phones show
    the front 16 rows. */
 .cabin{display:grid;row-gap:12px;margin-top:32px}
 .cabin-side{display:grid;grid-template-columns:repeat(24,minmax(0,14px));grid-template-rows:auto auto;grid-auto-flow:column;justify-content:space-between;gap:4px}
 .g-seat{position:relative;aspect-ratio:1;background:var(--web-raised)}
 .g-seat.is-insured{background:transparent;box-shadow:inset 0 0 0 1px var(--augur-color-surface-dark-mist)}
 .g-seat>span{position:absolute;inset:0;background:var(--primary)}
 /* Gate, in two lanes that tell the explanation (owner, 19 Oct 2026: no dead space; one lane left the
    example's foot empty). This review: the proposal brakes into the review, where two tall Green bars
    stand as a pause sign (the upgrade is held), and the rest is dashed to an empty square, Live. A later
    review: a check marks the review passed and the proposal runs all the way to Live. Green marks only
    this answer's hold. */
 .gate-lane+.gate-lane{margin-top:20px}
 .gate-caption{display:block;margin-bottom:8px}
 .gate .g-track{height:64px}
 .gate-path{position:absolute;left:0;width:var(--gate);top:31px;height:2px;background:var(--muted-foreground)}
 .gate-ahead{position:absolute;left:var(--gate);right:16px;top:31px;height:2px;background:repeating-linear-gradient(90deg,var(--web-outline) 0 6px,transparent 6px 12px)}
 .gate-bars{position:absolute;left:var(--gate);top:0;display:flex;gap:12px;height:64px;margin-left:-14px}
 .gate-bars i{width:8px;background:var(--primary)}
 .gate-goal{position:absolute;right:0;top:24px;width:16px;height:16px;border:2px solid var(--web-outline)}
 .gate-run{position:absolute;inset:0 auto 0 0;width:calc(var(--gate) - 24px)}
 .gate .g-item{top:24px;transform-origin:right}
 .is-later .gate-path{width:auto;right:8px}
 .gate-check{position:absolute;left:var(--gate);top:16px;display:grid;place-items:center;width:32px;height:32px;margin-left:-16px;background:var(--web-tile);color:var(--foreground)}
 .gate-check svg{overflow:visible}
 .gate-check svg{width:20px;height:20px}
 .gate-check polyline{fill:none;stroke:currentColor;stroke-width:1.75;stroke-linecap:square;stroke-linejoin:miter;stroke-dasharray:1 3}
 .is-later .gate-run{width:calc(100% - 8px)}
 .gate-pulse{left:calc(100% - 8px);top:32px;border-color:var(--foreground)}
 @media(max-width:1023px){.case-graphic{flex:none;padding-top:28px}.market{flex:none}.market-plot{height:120px}}
 @media(max-width:767px){.cabin-side{grid-template-columns:repeat(16,minmax(0,14px))}.g-seat:nth-child(n+33){display:none}}
 @media(forced-colors:active){.market-line{stroke:CanvasText}.market-area,.g-pulse,.market-scrub{display:none}.market-grid i,.g-seat,.g-base,.g-item,.g-tick,.gate-path,.g-end i,.market-head i,.flight-progress i{forced-color-adjust:none;background:CanvasText}.g-seat.is-insured{forced-color-adjust:none;background:Canvas;box-shadow:inset 0 0 0 1px CanvasText}.gate-goal{border-color:CanvasText}.market-answer{border-color:CanvasText}.g-seat>span,.flight-progress i.is-late,.gate-bars i,.market-head.is-yes i{forced-color-adjust:none;background:Highlight}.gate-check{forced-color-adjust:none;background:Canvas;color:CanvasText}}
</style>
