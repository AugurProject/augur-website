---
// Shared copy for the Learn guide headers; each homepage design keeps its own.
import {heritageFields} from '../../data/heritage-fields';
import {makeHeritage} from '../../data/heritage';
interface Props {seed?:number;width?:number;height?:number;glow?:boolean;id?:string;class?:string;}
const {seed=2020,width=1440,height=764,glow=false,id='heritage',class:className}=Astro.props;
const exact=seed===2020&&width===1440&&height===764?heritageFields['2020']:seed===2026&&width===1440&&height===424?heritageFields['2026']:undefined;
const squares=exact?exact.map(([x,y,opacity,accent])=>({x,y,opacity,accent:!!accent})):makeHeritage(seed,width,height);
---
<svg class:list={['heritage-field',className]} viewBox={`0 0 ${width} ${height}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false" data-heritage={glow?'interactive':undefined}>
  {glow&&<defs><radialGradient id={`${id}-falloff`}><stop offset="0" stop-color="white"/><stop offset=".3" stop-color="white" stop-opacity=".85"/><stop offset="1" stop-color="white" stop-opacity="0"/></radialGradient><mask id={`${id}-mask`} maskUnits="userSpaceOnUse" x="0" y="0" width={width} height={height}><circle data-heritage-radius cx="-1000" cy="-1000" r="200" fill={`url(#${id}-falloff)`}/></mask></defs>}
  <g class="heritage-base">{squares.map((s,i)=><rect x={s.x} y={s.y} width="3" height="3" fill={s.accent?'var(--primary)':'var(--foreground)'} opacity={s.opacity} class:list={{twinkle:glow&&i%12===0}} style={glow&&i%12===0?`--rest:${s.opacity};--dim:${s.opacity*.72};--cycle:${2.6+(i*13%9)*.35}s;--phase:${-(i*17%101)/10}s`:undefined} />)}</g>
  {glow&&<g class="heritage-glow" mask={`url(#${id}-mask)`}>{squares.map(s=><rect x={s.x} y={s.y} width="3" height="3" fill={s.accent?'var(--primary)':'var(--foreground)'} opacity={s.accent?.9:.7}/>)}</g>}
</svg>
<style>
.heritage-field{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
.heritage-glow{opacity:0;transition:opacity 450ms ease-out}.heritage-field[data-pointer-active] .heritage-glow{opacity:1;transition-duration:120ms}
.heritage-field[data-active] .twinkle{animation:twinkle var(--cycle) ease-in-out var(--phase) infinite alternate}
@keyframes twinkle{from{opacity:var(--rest)}to{opacity:var(--dim)}}
/* Hero background drift: the whole field moves a few pixels on a long loop,
   composited as one layer, only while the hero ambience runs. */
:global([data-ambient]) > .heritage-field[data-heritage=interactive]{animation:field-drift 24s ease-in-out infinite;animation-play-state:paused}
:global([data-ambient=running]) > .heritage-field[data-heritage=interactive]{animation-play-state:running}
@keyframes field-drift{0%,100%{transform:none}25%{transform:translate(6px,-3px)}75%{transform:translate(-6px,3px)}}
@media(prefers-reduced-motion:reduce){.twinkle,.heritage-field{animation:none!important}.heritage-glow{display:none}}
@media print{.heritage-field{display:none}}
</style>
