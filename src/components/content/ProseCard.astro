---
// A framed note inside ported blog posts and fork guides (archive notices, key terms, tables).
// Replaces the old site's prose-card.astro; MDX passes `class` through as before.
interface Props { class?: string }
const { class: className } = Astro.props;
---
<div class:list={['prose-card', className]}><slot /></div>
<style>
 .prose-card{padding:24px 28px;border:1px solid var(--web-outline);background:var(--web-quiet)}
 .prose-card :global(>:first-child){margin-top:0}
 @media(max-width:767px){.prose-card{padding:20px}}
</style>
