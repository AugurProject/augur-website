---
import { query, walkthrough } from '../../data/walkthrough';
const rows=[['Query opened · fee paid','15 REP'],['Report · YES','15 REP bond'],['Challenge · NO','30 REP bond'],['Final answer','NO']];
---
<section class="example-question" aria-labelledby="example-question">
 <div class="question-meta"><h2 id="example-question">Example question</h2><span class="status pending">Awaiting report</span></div>
 <p class="question-title">{query.title}</p>
 <div class="question-facts"><div><span>Information cutoff</span><p>{query.cutoffDate}</p></div><div><span>Possible outcomes</span><p class="outcomes">{query.outcomes.map(outcome=><span>{outcome}</span>)}</p></div></div>
</section>
<ol class="guide-timeline">{walkthrough.map((step,index)=><li id={`step-${index+1}`}><span class="step-number" aria-hidden="true">{String(index+1).padStart(2,'0')}</span><div><h2>{step.title}</h2><p>{step.description}</p><div class="guide-ledger"><span>{rows[index][0]}</span><strong>{rows[index][1]}</strong></div></div></li>)}</ol>
<style>
 .example-question{background:var(--card);padding:32px;margin:56px 0 48px}.question-meta{display:flex;justify-content:space-between;gap:16px;align-items:center}.question-meta h2{font:400 14px/20px var(--font-heading)}.question-meta .status{font-size:13px}.question-title{font:600 24px/32px var(--font-heading);margin-top:24px}.question-facts{display:grid;grid-template-columns:1fr 1fr;gap:32px;margin-top:40px}.question-facts>div>span{font-size:14px;color:var(--muted-foreground)}.question-facts p{margin-top:8px;font-size:16px}.outcomes{display:flex;gap:12px}.outcomes span{border:1px solid var(--web-outline);padding:2px 10px;font:600 13px/18px var(--font-heading)}.guide-timeline{list-style:none;padding:0;margin:0}.guide-timeline li{position:relative;display:grid;grid-template-columns:48px 1fr;gap:28px;padding-bottom:54px}.guide-timeline li:last-child{padding-bottom:6px}.guide-timeline li:not(:last-child)::after{content:'';position:absolute;top:48px;bottom:0;left:24px;width:1px;background:var(--border-quiet)}.step-number{display:grid;place-items:center;width:48px;height:48px;border:1px solid var(--primary);color:var(--primary);font:600 16px/24px var(--font-heading)}.guide-timeline li:last-child .step-number{background:var(--primary);color:var(--primary-foreground)}.guide-timeline h2{font-size:30px;line-height:40px}.guide-timeline li p{font-size:18px;line-height:30px;color:var(--muted-foreground);margin-top:14px}.guide-ledger{display:flex;justify-content:space-between;gap:16px;border:1px solid var(--web-outline);padding:12px 16px;margin-top:24px;font-size:15px;line-height:22px}.guide-ledger strong{font-weight:600;white-space:nowrap}.guide-timeline li:last-child .guide-ledger{border-color:var(--primary)}.guide-timeline li:last-child strong{color:var(--primary)}@media(max-width:600px){.example-question{padding:24px}.question-meta{align-items:start;flex-direction:column}.question-facts{grid-template-columns:1fr}.guide-timeline li{grid-template-columns:36px 1fr;gap:16px}.step-number{width:36px;height:36px;font-size:14px}.guide-timeline li:last-child{padding-bottom:6px}.guide-timeline li:not(:last-child)::after{left:18px;top:36px}.guide-timeline h2{font-size:24px;line-height:32px}.guide-ledger{flex-direction:column;gap:8px}}
</style>
