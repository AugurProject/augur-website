---
import Brand from '../primitives/Brand.astro';
import Icon from '../primitives/Icon.astro';
import Button from '../primitives/Button.astro';
import {navigation,navigationGroups,pages,type NavigationItem} from '../../data/navigation';
import {links} from '../../data/links';
import {newsletter} from '../../data/newsletter';
import {forms} from '../../data/forms';
import {site} from '../../data/site';
// The address stays for the newsletter's consent line; the contact band no longer shows it.
// Both rows sit on the site's 500 / 80 / 668 heading grid, so the newsletter and the first
// link column share one edge with every section above. One footer nav landmark; every
// footer heading is an h2, a peer of the contact title rather than nested under it.
// On the homepage the footer settles in as one group, with no stagger (reveal-v2.js); every other page renders
// it unchanged.
const reveal=Astro.url.pathname==='/'&&site.homeDesign==='melo'?'':undefined;
---
<footer class="site-footer" data-reveal={reveal}>
  <div id="contact" class="contact-band">
    <div class="site-container footer-grid">
      <div class="contact-copy"><h2 id="contact-title">Talk to the Augur team.</h2><p>Ask about the protocol or share feedback. Building on it? Tell us what your project needs.</p><div class="contact-actions"><Button href={pages.contact}>Talk to us</Button></div></div>
      <div class="newsletter"><h2 id="newsletter-title">Follow Augur's progress</h2><p>Research, development and product updates.</p>
        <form class="newsletter-form" action={forms.url ? forms.url+newsletter.path : undefined} method={forms.url ? 'post' : 'dialog'} aria-labelledby="newsletter-title" data-newsletter={forms.url ? 'live' : 'offline'}>
          <div class="newsletter-row"><div class="field"><label for="newsletter-email">Email address</label><input type="email" id="newsletter-email" name="email" autocomplete="email" inputmode="email" placeholder="you@example.com" required maxlength="254" aria-describedby={forms.url ? 'newsletter-email-error newsletter-consent' : 'newsletter-email-error'} /></div><Button type="submit" variant="outline">Subscribe</Button></div>
          {forms.url && <div class="newsletter-trap" aria-hidden="true"><label for="newsletter-nickname">Leave this empty</label><input type="text" id="newsletter-nickname" name={forms.honeypot} tabindex="-1" autocomplete="off" /></div>}
          <p class="field-error" id="newsletter-email-error" hidden></p>
          <p class="newsletter-status" role="status" aria-live="polite" data-newsletter-status></p>
          {forms.url && <p class="newsletter-consent" id="newsletter-consent">{newsletter.consent} <a href={pages.contact}>contact us</a>.</p>}
        </form></div>
    </div>
  </div>
  <div class="site-container footer-grid directory">
    <div class="identity"><a href="/" aria-label="Augur home"><Brand /></a><p>Augur's work is funded and coordinated by the <a href={links.foundation.url}>Lituus Foundation<Icon name="arrow-up-right"/></a>.</p><ul class="legal-links" aria-label="Legal">{navigation.legal.map(item=><li><a href={item.href}>{item.label}</a></li>)}</ul></div>
    <nav class="footer-links" aria-label="Footer">{navigationGroups.map(group=><div><h2>{group.label}</h2><ul>{group.items.map(item=><li><a class="line-link" href={item.href}>{(item as NavigationItem).logo&&<Icon name={(item as NavigationItem).logo!} class="social-logo"/>}<span class="button-label">{item.label}</span>{('external' in item && item.external)&&<Icon name="arrow-up-right"/>}</a></li>)}</ul></div>)}</nav>
  </div>
</footer>
<script>
 // Without JavaScript the form posts to the augur-forms Worker, which redirects to a result page.
 // Here it validates first, posts in place and shows the Worker's message: only `ok` means stored.
 // A form-urlencoded body keeps the cross-origin POST a simple request, with no CORS preflight.
 // Offline (no PUBLIC_FORMS_URL in the build), method="dialog" keeps submits local and the
 // script says plainly that nothing was sent.
 import {isEmail,newsletter} from '../../data/newsletter';
 const form=document.querySelector<HTMLFormElement>('[data-newsletter]');
 if(form){
  form.noValidate=true;
  const input=form.querySelector<HTMLInputElement>('input[type=email]')!;
  const error=form.querySelector<HTMLElement>('#newsletter-email-error')!;
  const status=form.querySelector<HTMLElement>('[data-newsletter-status]')!;
  // A flag, not button.disabled: disabling the focused button would drop keyboard focus.
  let sending=false;
  const showError=(message:string)=>{error.textContent=message;error.hidden=!message;input.setAttribute('aria-invalid',String(Boolean(message)));};
  const validate=()=>{
   const value=input.value.trim();
   const message=!value?'Enter your email address.':input.validity.typeMismatch||!isEmail(value)?newsletter.messages.invalid:'';
   showError(message);
   return !message;
  };
  input.addEventListener('blur',()=>{if(input.value.trim()||input.getAttribute('aria-invalid')==='true')validate();});
  input.addEventListener('input',()=>{status.replaceChildren();if(input.getAttribute('aria-invalid')==='true')validate();});
  form.addEventListener('submit',async event=>{
   event.preventDefault();if(sending)return;status.replaceChildren();
   if(!validate()){input.focus();return;}
   if(form.dataset.newsletter==='offline'){
    const blog=document.createElement('a');blog.href='/blog/';blog.textContent='Follow the blog';
    status.append('Email sign-up isn’t connected yet, so nothing was sent or saved. ',blog,' for updates in the meantime.');
    return;
   }
   sending=true;form.setAttribute('aria-busy','true');
   try{
    const body=new URLSearchParams([...new FormData(form)].map(([key,value])=>[key,String(value)]));
    const response=await fetch(form.action,{method:'POST',body,headers:{accept:'application/json'}});
    const result=await response.json() as {ok:boolean;status:string;message:string;fieldErrors?:Record<string,string>};
    if(result.status==='invalid'){showError(result.fieldErrors?.email??result.message);input.focus();}
    else{status.textContent=result.message;if(result.ok)form.reset();}
   }catch{status.textContent=newsletter.messages.error;}
   finally{sending=false;form.removeAttribute('aria-busy');}
  });
 }
</script>
<style>
.footer-grid{display:grid;grid-template-columns:minmax(0,500fr) minmax(0,668fr);gap:80px}
.contact-band{padding-block:96px}
.contact-copy h2{margin-bottom:16px;text-wrap:balance}.contact-copy p{font-size:18px;line-height:28px;color:var(--muted-foreground);max-width:540px;margin-bottom:24px}
/* The footer, consent line included, points to the contact page alone; the page gives the email address (owner, 30 Oct 2026; consent line 31 Oct 2026). */
.contact-actions{display:flex;flex-wrap:wrap;align-items:center;gap:16px 32px}
.newsletter h2{font-size:20px;line-height:26px;letter-spacing:0;margin-bottom:12px}.newsletter>p{color:var(--muted-foreground);margin-bottom:24px}
.newsletter-row{display:flex;align-items:flex-end;gap:12px}.newsletter .field{flex:1;min-width:0;gap:12px}.newsletter .field>label{font-weight:400}.newsletter .field input{background:var(--web-tile)}
.newsletter .field-error{margin-top:12px}.newsletter-status{margin-top:12px;font-size:14px;line-height:20px;color:var(--muted-foreground)}.newsletter-status:empty{display:none}.newsletter-status a{color:var(--foreground)}
.newsletter-consent{margin-top:12px;font-size:14px;line-height:20px;color:var(--muted-foreground)}.newsletter-consent a{color:var(--foreground)}
/* Off-screen rather than display:none, so form-filling bots still see the trap field. */
.newsletter-trap{position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden}
.directory{padding-block:48px 64px;border-top:1px solid var(--web-outline)}
/* A hairline opens the directory, so the contact band and the links read as two groups. The logo heads the
   first column level with the link headings, and the funding line sits 16 under it. */
.identity{display:flex;flex-direction:column;justify-content:flex-start;align-items:flex-start;gap:16px}.identity p{font-size:14px;line-height:22px;color:var(--muted-foreground);max-width:300px}
/* Privacy and Terms sit under the funding line, in its size and colour. */
.legal-links{display:flex;flex-wrap:wrap;gap:4px 24px;list-style:none;padding:0;margin:0;font-size:14px;line-height:22px}.legal-links a{display:inline-flex;align-items:center;min-height:24px;color:var(--muted-foreground)}.legal-links a:hover{color:var(--foreground)}
.identity p a{color:var(--foreground);white-space:nowrap}.identity p a:hover{text-decoration-thickness:2px}.identity p :global(.web-icon),.identity p :global(.web-icon svg){width:12px;height:12px}.identity p :global(.web-icon){margin-left:2px;vertical-align:-1px}
.footer-links{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:32px}
.footer-links h2{font:600 14px/20px var(--font-heading);letter-spacing:0;color:var(--muted-foreground);margin-bottom:16px}.footer-links ul{list-style:none;padding:0;margin:0}
.footer-links li a{display:flex;align-items:center;gap:4px;min-height:38px;line-height:24px}.footer-links :global(.web-icon),.footer-links :global(.web-icon svg){width:14px;height:14px}
/* Community destinations carry their logo before the name. */
.footer-links :global(.social-logo),.footer-links :global(.social-logo svg){width:18px;height:18px}.footer-links :global(.social-logo){margin-right:6px;color:var(--muted-foreground);transition:color 180ms ease-out}.footer-links a:hover :global(.social-logo){color:var(--foreground)}
/* Below 1280 a 1fr / 1fr contact row over four equal link columns with the same gap, so the
   newsletter's edge lands on the third column; the identity row splits on that edge too. */
@media(max-width:1279px){.footer-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:48px}.directory{grid-template-columns:minmax(0,1fr)}.identity{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px 48px;align-items:center;padding-bottom:0}.legal-links{grid-column:2}.footer-links{gap:48px}}
@media(max-width:767px){.contact-band{padding-block:64px}.footer-grid{grid-template-columns:minmax(0,1fr)}.directory{padding-block:40px 48px;row-gap:40px}.identity{display:flex;align-items:flex-start;gap:24px}.footer-links{grid-template-columns:repeat(2,minmax(0,1fr));gap:40px 24px}.footer-links li a{min-height:44px}}
/* Under 375 px the field would clip its placeholder beside the button: stack them. */
@media(max-width:374px){.newsletter-row{flex-direction:column;align-items:stretch}}
</style>
