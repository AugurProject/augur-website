---
import Icon from '../primitives/Icon.astro';
import { formatShortDate } from '../../data/blog';
import { getXPost, xPostAuthor, type XPostKey } from '../../data/x-posts';

interface Props { post: XPostKey }
const { post: key } = Astro.props;
const post = getXPost(key);
const paragraphs = post.text.split('\n\n');
const mention = /((?<![\p{L}\p{N}_@])@[a-z\d_]{1,15}(?![a-z\d_]))/iu;
---
<figure class="x-post-frame">
  <a class="x-post" href={post.url} target="_blank" rel="noopener noreferrer" aria-label={`Read on X: ${post.label} (opens in a new tab or window)`}>
    <div class="x-post-header">
      <span class="x-post-avatar"><img src={xPostAuthor.avatar} alt="" width="28" height="28" loading="lazy" /></span>
      <div class="x-post-author"><strong>{xPostAuthor.name}</strong><span>{xPostAuthor.handle}</span></div>
      <Icon name="x-logo" class="x-post-brand" />
    </div>
    <div class="x-post-content">
      <blockquote cite={post.url}>
        {paragraphs.map(paragraph => (
          <p>{paragraph.split(mention).map((part, index) => index % 2 ? <span class="x-post-mention">{part}</span> : part)}</p>
        ))}
      </blockquote>
    </div>
    <div class="x-post-footer">
      <span class="x-post-meta">Excerpt from X<span aria-hidden="true"> · </span><time datetime={post.date}>{formatShortDate(new Date(post.date))}</time></span>
      <span class="x-post-action">Read on X<Icon name="arrow-up-right" /></span>
    </div>
  </a>
</figure>
<style>
  .x-post-frame{max-inline-size:550px;margin-inline:auto}
  a.x-post{display:grid;gap:16px;padding:clamp(16px,4vw,24px);border:1px solid var(--web-outline);background:var(--web-quiet);overflow-wrap:anywhere;text-decoration:none}
  a.x-post:is(:hover,:focus-visible){border-color:var(--brand-hover-edge)}
  .x-post-header{display:flex;align-items:center;gap:12px}
  .x-post-avatar{display:grid;place-items:center;inline-size:44px;block-size:44px;padding:7px;flex:none;background:var(--web-well);border:1px solid var(--web-outline)}
  .x-post-avatar img{border:0;margin:0;width:28px;height:28px}
  .x-post-author{display:grid;line-height:1.35;font-family:var(--font-heading);min-inline-size:0}
  .x-post-author strong{font-size:16px}
  .x-post-author span,.x-post-meta{font-size:14px;color:var(--muted-foreground)}
  .x-post-header :global(.x-post-brand){margin-inline-start:auto;align-self:start;flex:none}
  .x-post-header :global(.x-post-brand svg){inline-size:24px;block-size:24px}
  .x-post blockquote{padding:0;border:0}
  .x-post-content p{margin:0;font-size:clamp(17px,2.5vw,18px);line-height:1.55;color:var(--foreground)}
  .x-post-content p+p{margin-block-start:12px}
  .x-post-mention{color:var(--primary)}
  .x-post-footer{display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:4px 20px;border-block-start:1px solid var(--web-outline);padding-block-start:12px}
  .x-post-action{display:inline-flex;align-items:center;gap:6px;font:600 14px/20px var(--font-heading);text-decoration:underline;text-underline-offset:4px}
  .x-post-action :global(.web-icon svg){inline-size:14px;block-size:14px}
  @media(forced-colors:active){a.x-post{border-color:LinkText}}
</style>
