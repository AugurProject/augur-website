---
import { crossAnywhere as diagram } from '../../data/diagrams';
// Four crossers rest on the open edge (the static diagram). The loop
// (tenet-choreography.ts) brings each one in, lights it Green, keeps it on as a
// Paper member, settles it to Mist and later lets it leave and return. Crossers
// and trails sit in a `data-lead` wrapper that plays their one-off lead-in.
// Every square that lights up pulses: its group pops and its outline (an
// invisible 1 px square at rest) grows and fades.
const mist = 'var(--mark-participant, #71728A)';
---
<svg viewBox="0 0 336 168" width="336" height="168" class="tenet-diagram" data-cross aria-hidden="true">
  <rect data-edge {...diagram.edge} fill="none" stroke={mist} stroke-width="3" stroke-dasharray="3 9" />
  {diagram.participants.map(([x,y],i)=><g data-motion={`cross-seat-pop:${i}`}>
    <rect data-participant x={x} y={y} width="20" height="20" fill={mist}/>
    <rect data-motion={`cross-seat:${i}`} x={x} y={y} width="20" height="20" fill="var(--foreground)" opacity="0"/>
  </g>)}
  {diagram.participants.map(([x,y],i)=><rect data-motion={`cross-seat-ring:${i}`} x={x+.5} y={y+.5} width="19" height="19" fill="none" stroke="var(--foreground)" opacity="0"/>)}
  {diagram.trails.map((trail,i)=><g data-lead={`cross-trail:${i}`}><rect data-motion={`cross-trail:${i}`} x={trail.x} y={trail.y} width={trail.size} height={trail.size} opacity={trail.opacity} fill={i>5?'var(--primary)':mist}/></g>)}
  {diagram.crossers.map((square,i)=><g data-lead={`cross:${i}`}><g data-motion={`cross:${i}`} data-crosser={i}>
    <g data-motion={`cross-pop:${i}`}>
      <rect x={square.x} y={square.y} width="20" height="20" fill={i===3?'var(--primary)':mist}/>
      {i===3?<rect data-motion={`cross-mist:${i}`} x={square.x} y={square.y} width="20" height="20" fill={mist} opacity="0"/>:<rect data-motion={`cross-green:${i}`} x={square.x} y={square.y} width="20" height="20" fill="var(--primary)" opacity="0"/>}
      <rect data-motion={`cross-paper:${i}`} x={square.x} y={square.y} width="20" height="20" fill="var(--foreground)" opacity="0"/>
    </g>
    <rect data-motion={`cross-ring:${i}`} x={square.x+.5} y={square.y+.5} width="19" height="19" fill="none" stroke="var(--primary)" opacity="0"/>
  </g></g>)}
</svg>
