---
import { peerMesh as diagram } from '../../data/diagrams';
import { meshTour } from '../../motion/tenet-choreography';
// The relay rests on the first square of its tour, which is lit at rest. Every
// link and square has a lit twin the loop fades in and out (tenet-choreography.ts);
// where the relay lands, the square pops and its Green outline grows and fades.
const home = meshTour[0];
const [homeX, homeY] = diagram.participants[home]!;
---
<svg viewBox="0 0 336 168" width="336" height="168" class="tenet-diagram" data-mesh aria-hidden="true">
  {diagram.links.map(([x1,y1,x2,y2])=><path data-link d={`M${x1} ${y1}L${x2} ${y2}`} pathLength="1" stroke="var(--primary)" opacity=".45" stroke-width="1"/>)}
  {diagram.links.map(([x1,y1,x2,y2],i)=><path data-motion={`mesh-link:${i}`} d={`M${x1} ${y1}L${x2} ${y2}`} stroke="var(--primary)" opacity="0" stroke-width="2" style="filter:drop-shadow(0 0 6px rgb(42 231 168 / .9))"/>)}
  {diagram.participants.map(([x,y],i)=><g data-motion={`mesh-pop:${i}`}>
    <rect data-participant x={x} y={y} width="20" height="20" fill="var(--mark-participant, #71728A)"/>
    <rect data-motion={`mesh-node:${i}`} x={x} y={y} width="20" height="20" opacity={i===home?1:0} fill="var(--primary)" style="filter:drop-shadow(0 0 18px rgb(42 231 168 / .6))"/>
  </g>)}
  {diagram.participants.map(([x,y],i)=><rect data-motion={`mesh-ring:${i}`} x={x+.5} y={y+.5} width="19" height="19" fill="none" stroke="var(--primary)" opacity="0"/>)}
  <rect data-motion="mesh-packet" x={homeX+7} y={homeY+7} width="6" height="6" fill="var(--primary)"/>
</svg>
