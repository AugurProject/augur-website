---
import "../index.css";
import "../styles/site.css";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";

type Props = {
  title: string;
  description: string;
  canonical?: string | false;
  indexable?: boolean;
};

const { title, description, canonical, indexable = false } = Astro.props;
// The public origin is stable, while M1 preview and placeholder pages remain noindex.
const canonicalUrl = canonical === false ? undefined : canonical ?? new URL(Astro.url.pathname, "https://augur.net").href;
const documentTitle = title === "Augur" ? title : `${title} · Augur`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Static fallbacks: the --card role (surface-light-raised / surface-dark-1) at the pin. -->
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" data-site-theme-color />
    <meta name="theme-color" content="#161629" media="(prefers-color-scheme: dark)" data-site-theme-color />
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? "index,follow" : "noindex,nofollow"} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <title>{documentTitle}</title>
    <script is:inline>
      try {
        const choice = localStorage.getItem("augur-theme");
        if (choice === "light" || choice === "dark") document.documentElement.dataset.theme = choice;
      } catch { /* System preference remains available when storage is blocked. */ }
    </script>
  </head>
  <body>
    <a class="site-skip-link" href="#main-content">Skip to content</a>
    <SiteHeader />
    <div id="main-content" tabindex="-1" class="site-content"><slot /></div>
    <SiteFooter />
    <script>
      // One sun/moon toggle (the design-system docs masthead pattern): with
      // nothing stored the system preference governs; a press pins the
      // opposite of the theme in effect.
      const dark = window.matchMedia("(prefers-color-scheme: dark)");
      const toggles = document.querySelectorAll<HTMLButtonElement>("[data-site-theme-toggle]");
      const effective = () => {
        const applied = document.documentElement.dataset.theme;
        return applied === "light" || applied === "dark" ? applied : dark.matches ? "dark" : "light";
      };
      const sync = () => {
        const theme = effective();
        const next = theme === "dark" ? "light" : "dark";
        for (const toggle of toggles) {
          toggle.dataset.theme = theme;
          toggle.setAttribute("aria-label", `Theme: ${theme === "dark" ? "Dark" : "Light"}. Switch to ${next === "dark" ? "Dark" : "Light"}`);
          const name = toggle.querySelector("[data-site-theme-name]");
          if (name) name.textContent = theme === "dark" ? "Dark" : "Light";
        }
        // Browser chrome follows the header surface. Without a stored choice
        // the two media-scoped metas already match the system theme.
        if (document.documentElement.dataset.theme) {
          const surface = getComputedStyle(document.documentElement).getPropertyValue("--card").trim();
          for (const meta of document.querySelectorAll<HTMLMetaElement>("meta[data-site-theme-color]")) {
            meta.removeAttribute("media");
            if (surface) meta.content = surface;
          }
        }
      };
      for (const toggle of toggles) {
        toggle.addEventListener("click", () => {
          const next = effective() === "dark" ? "light" : "dark";
          document.documentElement.dataset.theme = next;
          try { localStorage.setItem("augur-theme", next); } catch { /* Applies to this page only. */ }
          sync();
        });
      }
      dark.addEventListener("change", sync);
      sync();

      const disclosures = document.querySelectorAll<HTMLDetailsElement>(".site-nav-resources, .site-mobile-menu");
      for (const disclosure of disclosures) {
        disclosure.addEventListener("keydown", (event) => {
          if (event.key !== "Escape" || !disclosure.open) return;
          event.preventDefault();
          event.stopPropagation();
          disclosure.open = false;
          disclosure.querySelector<HTMLElement>("summary")?.focus();
        });
        // Close when keyboard focus moves to something outside the disclosure.
        // A null relatedTarget (window blur, click on inert area) is left to
        // the pointerdown handler below.
        disclosure.addEventListener("focusout", (event) => {
          const next = event.relatedTarget;
          if (disclosure.open && next instanceof Node && !disclosure.contains(next)) disclosure.open = false;
        });
      }
      document.addEventListener("pointerdown", (event) => {
        for (const disclosure of disclosures) {
          if (!disclosure.contains(event.target as Node)) disclosure.open = false;
        }
      });
    </script>
  </body>
</html>
