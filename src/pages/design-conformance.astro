---
import SiteLayout from "@/layouts/SiteLayout.astro";
import DesignSpecimen from "@/components/DesignSpecimen.astro";
import designSystem from "../../design-system.lock.json";

const releaseUrl = `https://github.com/${designSystem.repository}/releases/tag/${designSystem.version}`;
---

<SiteLayout
  title="Design-system conformance"
  description="Specimen of the pinned Augur Design System items installed in this website, in light and dark themes."
  canonical={false}
>
  <main class="site-frame site-scaffold">
    <p class="site-scaffold__status augur-type-editorial-label">Implementation proof · noindex · not linked from site navigation</p>
    <h1 class="augur-type-editorial-title">Design-system conformance</h1>
    <p class="site-scaffold__question">
      Every Augur Design System item this website installs, rendered from the committed registry source
      in both themes. The two panels force a theme; the page around them follows the theme toggle.
    </p>
    <p class="augur-type-metadata">
      Source: <code>{designSystem.repository}</code>{" "}release{" "}<a href={releaseUrl}><code>{designSystem.version}</code></a>{" "}(commit{" "}<code>{designSystem.resolved.commit.slice(0, 7)}</code>).
      Built items:{" "}{designSystem.items.map((item, i) => <>{i > 0 && ", "}<code>{item}</code></>)}.
      See{" "}<code>docs/DESIGN-SYSTEM.md</code>.
    </p>
    <div class="site-specimens">
      <DesignSpecimen theme="light" />
      <DesignSpecimen theme="dark" />
    </div>
  </main>
</SiteLayout>
