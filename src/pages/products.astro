---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/pages/PageHero.astro';
import { products } from '../data/products';
import Icon from '../components/primitives/Icon.astro';
---
<PageLayout title="Augur products" description="What Augur Lituus, Zoltar and Augur Statoblast do, their current status, research and code.">
 <PageHero title="Products" lead="Augur Lituus answers real-world questions for any app. Zoltar is a shared foundation that lets different oracle designs use REP. Augur Statoblast is a prediction market built on Zoltar."><nav class="actions" aria-label="Products">{products.map(product=><a class="button outline" href={`#${product.id}`}>{product.name}</a>)}</nav></PageHero>
 <section class="section site-container ruled">
  <div class="section-heading"><h2>How they fit together</h2><p class="lead">Each product has its own job. REP, Augur’s token, secures all of them.</p></div>
  <div class="roles" role="img" aria-label="Any app can ask Augur Lituus to resolve a real-world question. Separately, Statoblast Trading is the interface for Augur Statoblast, the prediction-market layer on Zoltar. REP secures the designs; this does not imply Augur Lituus runs on Zoltar.">
   <div class="role-column"><div class="role app"><h3>Any app</h3><p>Asks a real-world question and acts on the answer.</p></div><div class="role lituus"><h3>Augur Lituus</h3><p>The oracle: anyone can report, anyone can challenge, a fork is the last resort.</p></div></div>
   <div class="role-column"><div class="role"><h3>Statoblast Trading</h3><p>Trading interface for Augur Statoblast.</p></div><div class="role"><h3>Augur Statoblast</h3><p>Prediction markets: collateral, reporting, disputes and settlement.</p></div><div class="role"><h3>Zoltar</h3><p>Forkable oracle ledger that records questions, universes, REP and forks.</p></div></div>
  </div>
  <div class="rep-role"><h3>REP</h3><p>Reputation: the token holders put at risk to report, challenge and choose a side in a fork.</p></div>
  <p class="diagram-caption">Shows each product’s role. It doesn’t imply that Augur Lituus runs on Zoltar.</p>
 </section>
 {products.map((product,index)=><section id={product.id} class="section site-container ruled product"><div><h2 class:list={[{compact:index===2}]}>{product.name}</h2><p class="tagline">{product.tagline}</p><p class="description">{product.description}</p>{product.detail&&<p class="description">{product.detail}</p>}<div class="actions">{index===0&&<a class="button primary" href="/#how-it-works">See how it works</a>}{product.paper&&<a class="button outline" href={product.paper}>{index===0?'Read the whitepaper':'Read the research'}<Icon name="arrow-up-right"/></a>}<a class="button text" href={product.code}><span class="button-label">View the code</span><Icon name="arrow-up-right"/></a></div></div><dl class="product-facts"><div><dt>Status</dt><dd>{product.status}</dd></div>{product.builder&&<div><dt>Built by</dt><dd>{product.builder}</dd></div>}{product.design&&<div><dt>{index===0?'Design':'Research'}</dt><dd>{index===1?'Zoltar system overview':product.design}</dd></div>}<div><dt>Code</dt><dd>{product.codeLabel}</dd></div></dl></section>)}
</PageLayout>
<style>
 .ruled{padding-top:72px}.ruled .section-heading{margin-bottom:48px}.actions{display:flex;flex-wrap:wrap;gap:16px;margin-top:24px}.roles{display:grid;grid-template-columns:1fr 1fr;gap:16px}.role-column{display:flex;flex-direction:column;gap:16px}.role{padding:24px 28px;background:var(--web-quiet);border:1px solid var(--web-outline)}.role h3{font-size:22px;line-height:30px}.role p{margin-top:6px;color:var(--muted-foreground)}.app{border-style:dashed;background:transparent}.lituus{flex:1}.rep-role{display:flex;align-items:center;gap:24px;padding:24px 28px;background:var(--web-quiet);border:1px solid var(--web-outline);margin-top:16px}.rep-role h3::before{content:'';display:inline-block;background:var(--primary);width:7px;height:7px;margin-right:16px}.rep-role p{color:var(--muted-foreground)}.diagram-caption{font-size:15px;line-height:22px;color:var(--muted-foreground);margin-top:48px}.product{display:grid;grid-template-columns:minmax(0,748fr) minmax(0,420fr);gap:80px}.product h2{font-size:clamp(36px,3.89vw,56px);line-height:1.143}.product h2.compact{font-size:40px;line-height:48px}.tagline{font-size:26px;line-height:34px;color:var(--primary);margin-top:24px}.description{font-size:19px;line-height:30px;color:var(--muted-foreground);margin-top:24px}.product-facts{align-self:start;margin:0;background:var(--web-quiet);border:1px solid var(--web-outline);padding:28px}.product-facts>div+div{border-top:1px solid var(--border-quiet);margin-top:20px;padding-top:20px}.product-facts dd{overflow-wrap:anywhere}.product-facts dt{color:var(--muted-foreground);font-size:13px;line-height:18px}.product-facts dd{font-size:17px;line-height:26px;margin:4px 0 0}@media(max-width:1023px){.product{grid-template-columns:1fr;gap:40px}}@media(max-width:767px){.roles{grid-template-columns:1fr}.rep-role{display:block}.rep-role p{margin-top:12px}.product h2.compact{font-size:32px;line-height:40px}}
</style>
