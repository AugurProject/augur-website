---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import HeritageField from '../../components/art/HeritageField.astro';
import Glossary from '../../components/content/Glossary.astro';
import GuideWalkthrough from '../../components/content/GuideWalkthrough.astro';
export async function getStaticPaths() { return (await getCollection('learn')).map(guide=>({params:{slug:guide.id},props:{guide}})); }
interface Props { guide: CollectionEntry<'learn'>; }
const { guide }=Astro.props;
const { Content, headings }=await render(guide);
const series=(await getCollection('learn')).filter(g=>g.data.order).sort((a,b)=>a.data.order!-b.data.order!);
const position=series.findIndex(g=>g.id===guide.id);
const previous=position>0?series[position-1]:undefined;
const next=position>=0?series[position+1]:undefined;
const fullExample=guide.id==='how-augur-answers-a-question';
const contents=fullExample?[{slug:'example-question',text:'The example question'},...['Ask a question','Report an outcome','Challenge if needed','Use the final answer'].map((text,index)=>({slug:`step-${index+1}`,text:`${index+1}. ${text}`}))]:headings.filter(h=>h.depth===2);
---
<PageLayout title={`${guide.data.title} | Learn`} description={guide.data.description}>
 <header class="guide-header"><HeritageField seed={2020} width={1440} height={804}/><div class="site-container guide-header-content"><a href="/learn/" class="back-link">← Learn</a>{guide.data.order&&<div class="series-progress"><p>Start here · Guide {guide.data.order} of 4</p><div class="progress" aria-hidden="true">{series.map(item=><span class:list={[{complete:item.data.order!<=guide.data.order!}]} />)}</div></div>}<h1>{guide.data.title}</h1><p class="lead">{guide.data.description}</p>{guide.data.readingMinutes&&<p class="reading-time">{guide.data.readingMinutes} min read</p>}</div></header>
 <div class="site-container guide-body"><aside class="guide-rail"><nav aria-label="Start here guides"><h2>Start here</h2><ol>{series.map(item=><li><a href={`/learn/${item.id}/`} aria-current={item.id===guide.id?'page':undefined}><span>{String(item.data.order).padStart(2,'0')}</span>{item.data.title}</a></li>)}</ol></nav>{contents.length>0&&<nav aria-label="In this guide"><h2>In this guide</h2>{contents.map(heading=><a class="toc-link" href={`#${heading.slug}`}>{heading.text}</a>)}</nav>}</aside>
  <article class="reading-column"><div class="prose guide-prose"><Content /></div>{fullExample&&<GuideWalkthrough />}<section class="guide-terms"><div class="terms-heading"><h2>Terms in this guide</h2><a href="/learn/#key-terms">All key terms →</a></div><Glossary terms={guide.data.terms} compact /></section><nav class="guide-next" aria-label="Continue learning">{previous&&<a href={`/learn/${previous.id}/`}><span>Previous · Guide {previous.data.order}</span><strong>← {previous.data.title}</strong></a>}{next&&<a class="next" href={`/learn/${next.id}/`}><span>Next · Guide {next.data.order}</span><strong>{next.data.title} →</strong></a>}{!next&&<a class="next" href="/learn/"><span>Explore more</span><strong>All guides →</strong></a>}</nav></article>
 </div>
</PageLayout>
<style>
 .guide-header{position:relative;overflow:hidden;padding:72px 0 88px}.guide-header-content{position:relative}.back-link{display:inline-flex;align-items:center;min-height:44px;text-decoration:none;color:var(--muted-foreground)}.series-progress{margin-top:36px}.series-progress p{color:var(--muted-foreground);font-size:16px}.progress{display:flex;gap:4px;width:304px;max-width:100%;margin-top:12px}.progress span{height:4px;flex:1;background:var(--web-outline)}.progress .complete{background:var(--primary)}h1{font-size:clamp(36px,4.167vw,60px);line-height:1.1333;max-width:1120px;margin-top:24px;letter-spacing:-.02em}.lead{max-width:780px;margin-top:24px;color:var(--muted-foreground)}.reading-time{color:var(--muted-foreground);margin-top:24px}.guide-body{display:grid;grid-template-columns:264px minmax(0,720px);gap:120px;padding-block:80px 96px}.guide-rail{align-self:start;position:sticky;top:32px}.guide-rail h2{font:600 14px/20px var(--font-heading);color:var(--muted-foreground);margin:0 0 20px}.guide-rail ol{list-style:none;padding:0;margin:0}.guide-rail li a{display:flex;gap:16px;align-items:start;padding:0;min-height:42px;text-decoration:none;font:400 15px/22px var(--font-heading);color:var(--muted-foreground)}.guide-rail li a span{display:grid;place-items:center;width:24px;height:24px;flex:none;border:1px solid var(--web-outline);font-size:12px}.guide-rail a[aria-current=page]{color:var(--foreground)}.guide-rail a[aria-current=page] span{background:var(--primary);color:var(--primary-foreground);border-color:var(--primary)}.guide-rail nav+nav{margin-top:16px;padding-top:10px;border-top:1px solid var(--border-quiet)}.toc-link{display:block;padding:10px 0 10px 16px;border-left:1px solid var(--web-outline);font-size:15px;line-height:22px;text-decoration:none;color:var(--muted-foreground)}.toc-link:hover{color:var(--foreground);border-color:var(--primary)}.reading-column{min-width:0}.guide-prose :global(>p:first-child){font-size:22px;line-height:33px;color:var(--foreground)}.guide-terms{padding:32px;border:1px solid var(--web-outline);margin-top:32px}.terms-heading{display:flex;justify-content:space-between;gap:24px;margin-bottom:16px;align-items:center}.terms-heading h2{font-size:20px;line-height:26px}.terms-heading a{font-size:15px;text-decoration:none}.guide-next{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:48px}.guide-next a{display:flex;flex-direction:column;gap:12px;border:1px solid var(--web-outline);padding:24px;text-decoration:none}.guide-next a.next{border-color:var(--primary)}.guide-next span{font-size:14px;color:var(--muted-foreground)}.guide-next strong{font:600 20px/28px var(--font-heading)}@media(max-width:1200px){.guide-body{grid-template-columns:220px minmax(0,720px);gap:64px}}@media(max-width:1023px){.guide-body{grid-template-columns:1fr;gap:48px}.guide-rail{position:static}.guide-rail nav+nav{display:none}.guide-rail ol{display:grid;grid-template-columns:1fr 1fr;gap:8px 24px}}@media(max-width:600px){.guide-header{padding:40px 0 64px}.guide-rail ol,.guide-next{grid-template-columns:1fr}.guide-body{padding-block:48px 64px}.guide-terms{padding:24px}.terms-heading{display:block}.terms-heading a{display:inline-block;margin-top:12px}}
</style>
