---
import { Content, frontmatter } from '../../content/learn/how-augur-answers-a-question.md';
import PageLayout from '../../layouts/PageLayout.astro';
import ArticleHeader from '../../components/content/ArticleHeader.astro';
import Prose from '../../components/content/Prose.astro';
import GuideWalkthrough from '../../components/content/GuideWalkthrough.astro';
import Glossary from '../../components/content/Glossary.astro';
import { pages } from '../../data/navigation';

const { title, description, terms } = frontmatter;
const crumbs = [{ label: 'FAQ', href: pages.faq }, { label: title }];
---
<PageLayout title={`${title} | Augur`} description={description}>
  <ArticleHeader crumbs={crumbs} title={title} lead={description} />
  <div class="site-container guide-body">
    <article>
      <Prose><Content /></Prose>
      <GuideWalkthrough />
      <section class="guide-terms" aria-labelledby="guide-terms-heading">
        <h2 id="guide-terms-heading">Terms in this guide</h2>
        <Glossary terms={terms} compact />
      </section>
    </article>
  </div>
</PageLayout>
<style>
  .guide-body { padding-block: 56px 96px; }
  article { max-inline-size: 720px; margin-inline: auto; }
  .guide-terms { margin-block-start: 32px; border: 1px solid var(--outline); padding: clamp(20px, 5vw, 32px); }
  .guide-terms h2 { margin-block-end: 16px; font-size: 20px; }
</style>
