---
import SiteLayout from "@/layouts/SiteLayout.astro";
---
<SiteLayout title="Page not found" description="The requested Augur page was not found." canonical={false}>
  <main class="site-frame site-not-found">
    <p class="site-not-found__status augur-type-editorial-label">404 · Page not found</p>
    <h1 class="augur-type-editorial-title">Page not found</h1>
    <p class="site-not-found__requested" hidden>Requested address: <code data-requested-path></code></p>
    <p>That address does not lead to a page here. Start with the site overview, or use a direct route:</p>
    <ul class="site-not-found__links">
      <li><a href="/">Augur overview</a></li>
      <li><a href="/protocol/">How Augur works</a></li>
      <li><a href="/research/">Research and sources</a></li>
      <li><a href="/faq/">Common questions</a></li>
    </ul>
  </main>
  <script>
    // The address bar keeps the requested URL; also name it on the page.
    const requested = document.querySelector<HTMLElement>("[data-requested-path]");
    if (requested) {
      const path = location.pathname + location.search;
      try {
        requested.textContent = decodeURI(path);
      } catch {
        requested.textContent = path; // Malformed escapes: show the raw address.
      }
      requested.closest<HTMLElement>(".site-not-found__requested")?.removeAttribute("hidden");
    }
  </script>
</SiteLayout>
