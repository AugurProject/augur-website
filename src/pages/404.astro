---
import SiteLayout from "@/layouts/SiteLayout.astro";
---
<SiteLayout title="Page not found" description="The requested Augur page was not found.">
  <main class="scaffold">
    <p class="scaffold__status">404</p>
    <h1>Page not found</h1>
    <p class="scaffold__question">The requested URL does not exist in this build.</p>
    <ul>
      <li><a href="/">Home</a></li>
      <li><a href="/protocol/">Protocol</a></li>
      <li><a href="/research/">Research</a></li>
      <li><a href="/faq/">FAQ</a></li>
    </ul>
  </main>
</SiteLayout>
