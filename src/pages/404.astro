---
import SiteLayout from "@/layouts/SiteLayout.astro";
---
<SiteLayout title="Page not found" description="The requested Augur page was not found." canonical={false}>
  <main class="site-frame site-not-found">
    <p class="site-not-found__status augur-type-metadata">404 · Page not found</p>
    <h1 class="augur-type-editorial-title">Page not found</h1>
    <p>That address does not lead to a page here. Start with the site overview, or use a direct route:</p>
    <ul class="site-not-found__links">
      <li><a href="/">Augur overview</a></li>
      <li><a href="/protocol/">How Augur works</a></li>
      <li><a href="/developers/">For developers</a></li>
      <li><a href="/research/">Research and sources</a></li>
    </ul>
  </main>
</SiteLayout>
