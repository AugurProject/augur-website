---
import PageLayout from '../layouts/PageLayout.astro';
import Button from '../components/primitives/Button.astro';
import { pages } from '../data/navigation';
// Builds to dist/client/404.html. Workers static assets serve it, with status 404, for any path that
// matches no file (`assets.not_found_handling` in wrangler.jsonc), so its links must be root-relative.
---
<PageLayout title="Page not found | Augur" description="This page doesn’t exist on augur.net." noindex canonical={false}>
 <section class="not-found site-container">
  <h1>Page not found</h1>
  <p>There’s no page at this address. It may have moved, or the link may be mistyped.</p>
  <div class="not-found-actions">
   <Button href="/">Back to the homepage</Button>
   <Button href={pages.learn} variant="outline">Learn about Augur</Button>
  </div>
 </section>
</PageLayout>
<style>
.not-found{padding-block:96px}
.not-found h1{margin-bottom:16px}
.not-found p{font-size:18px;line-height:28px;color:var(--muted-foreground);max-width:560px;margin-bottom:32px}
.not-found-actions{display:flex;flex-wrap:wrap;gap:16px}
</style>
