---
import { Image } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/pages/PageHero.astro';
import { getPosts, postPath, formatPostDate, isoDate } from '../../data/blog';
// The old augur.net blog index ("The Augur Arc"), newest first. Not linked from the header or homepage
// beyond the existing Blog links (docs/reference/ported-content.md).
const posts = await getPosts();
---
<PageLayout title="The Augur Arc | Augur blog" description="News, updates, and progress from the Augur reboot">
 <PageHero title="The Augur Arc" lead="News, updates, and progress from the Augur reboot. Follow our journey as we rebuild decentralized prediction markets.">
  <p class="feed"><a class="line-link" href="/rss.xml"><span class="button-label">RSS feed</span></a></p>
 </PageHero>
 <section class="site-container posts" aria-label="Posts">
  <ol>{posts.map(post => <li><article class="post-card">
   <Image src={post.data.featuredImage} alt="" widths={[480, 960]} sizes="(max-width: 767px) calc(100vw - 48px), 480px" loading="lazy" decoding="async" />
   <div class="post-text">
    <h2><a href={postPath(post)}>{post.data.title}</a></h2>
    <p class="post-meta"><time datetime={isoDate(post.data.publishDate)}>{formatPostDate(post.data.publishDate)}</time> · By {post.data.author}</p>
    <p class="post-description">{post.data.description}</p>
   </div>
  </article></li>)}</ol>
 </section>
</PageLayout>
<style>
 .feed{margin-top:24px}
 .posts{padding-block:24px 96px}
 .posts ol{display:grid;gap:24px;list-style:none;margin:0;padding:0}
 /* The heading's link covers the whole card, so the card is one tab stop named by its title. */
 .post-card{position:relative;display:grid;grid-template-columns:minmax(0,480px) minmax(0,1fr);border:1px solid var(--web-outline);background:var(--web-quiet);transition:background-color 180ms ease-out}
 .post-card:hover{background:var(--web-tile)}
 .post-card img{width:100%;height:100%;aspect-ratio:1200/630;object-fit:cover;border-right:1px solid var(--web-outline)}
 .post-text{display:flex;flex-direction:column;gap:12px;padding:32px}
 .post-card h2{font-size:24px;line-height:32px;text-wrap:balance}
 .post-card h2 a{text-decoration:none}
 .post-card h2 a::after{content:'';position:absolute;inset:0}
 .post-card:hover h2 a{text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:5px}
 .post-card:has(a:focus-visible){outline:2px solid var(--ring);outline-offset:2px}
 .post-card h2 a:focus-visible{outline:none}
 .post-meta{font-size:14px;line-height:20px;color:var(--muted-foreground)}
 .post-description{color:var(--muted-foreground)}
 @media(max-width:1023px){.post-card{grid-template-columns:minmax(0,2fr) minmax(0,3fr)}.post-text{padding:24px}.post-card h2{font-size:20px;line-height:28px}}
 @media(max-width:767px){.posts{padding-block:8px 64px}.post-card{grid-template-columns:1fr}.post-card img{height:auto;border-right:0;border-bottom:1px solid var(--web-outline)}}
 @media(prefers-reduced-motion:reduce){.post-card{transition:none}}
 @media(forced-colors:active){.post-card:has(a:focus-visible){outline-color:Highlight}}
</style>
